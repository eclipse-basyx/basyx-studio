{
  "name": "studio",
  "version": "0.0.0",
  "private": true,
  "productName": "BaSyx Studio",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "nuxt build",
    "build:electron": "pnpm build:electron:app && electron-builder --publish never",
    "build:electron:app": "nuxt build --envName electron",
    "build:electron:linux": "pnpm build:electron:app && electron-builder --linux --publish never",
    "build:electron:mac": "pnpm build:electron:app && electron-builder --mac --publish never",
    "build:electron:win": "node scripts/require-build-platform.mjs win32 && pnpm build:electron:app && electron-builder --win --x64 --arm64 --publish never",
    "dev": "nuxt dev",
    "dev:electron": "nuxt dev --envName electron",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "@aas-core-works/aas-core3.1-typescript": "^1.0.1",
    "@mdi/font": "7.4.47",
    "@nuxtjs/i18n": "^10.2.3",
    "@pinia/colada-nuxt": "1.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "basyx-typescript-sdk": "^2.2.5",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.4.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.30",
    "vuetify": "^4.0.2",
    "vuetify-nuxt-module": "^1.0.0-beta.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/fonts": "^0.14.0",
    "@pinia/nuxt": "^1.0.2",
    "@vuetify/mcp": "^0.9.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-config-vuetify": "^4.3.4",
    "nuxt-electron": "^0.7.0",
    "pnpm": "11.8.0",
    "sass": "^1.98.0",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "copyright": "Copyright (C) 2026 the Eclipse BaSyx Authors",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      ".output/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "buildUniversalInstaller": false
    },
    "linux": {
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}

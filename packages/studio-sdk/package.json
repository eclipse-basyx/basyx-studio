{
  "name": "@basyx/studio-sdk",
  "version": "0.1.10",
  "description": "Client SDK for BaSyx Studio apps: capability calls, context and theme over the studio-sdk/0 bridge, and an in-memory Studio for tests",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eclipse-basyx/basyx-studio.git",
    "directory": "packages/studio-sdk"
  },
  "homepage": "https://github.com/eclipse-basyx/basyx-studio/tree/main/packages/studio-sdk#readme",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol.ts",
    "./backend": "./src/backend.ts",
    "./testing": "./src/testing.ts",
    "./app-manifest.schema.json": "./app-manifest.schema.json"
  },
  "files": [
    "dist",
    "src",
    "app-manifest.schema.json",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./protocol": {
        "types": "./dist/protocol.d.ts",
        "default": "./dist/protocol.js"
      },
      "./backend": {
        "types": "./dist/backend.d.ts",
        "default": "./dist/backend.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "./app-manifest.schema.json": "./app-manifest.schema.json"
    }
  }
}

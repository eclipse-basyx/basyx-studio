# Studio configuration for local development against the test environment
# in test-setup/ (pnpm testenv:up). All values are test-only.
# Copy to .env: cp .env.example .env

# Public origin of this Studio Service (hosted mode).
STUDIO_PUBLIC_URL=http://localhost:3000

# Hosted metadata in the test environment's PostgreSQL. Remove the line to use
# an embedded PGlite database under STUDIO_DATA_DIR instead (ADR 0011).
STUDIO_DATABASE_URL=postgres://studio:studio@localhost:15432/studio
STUDIO_DATA_DIR=.data/studio

# 32 random bytes, base64url. Encrypts tokens and stored secrets at rest.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
STUDIO_DATA_KEY=dGVzdC1vbmx5LWRhdGEta2V5LWZvci1sb2NhbC1kZXY

# Studio login (OIDC authorization code + PKCE) against the test realm.
STUDIO_OIDC_ISSUER=http://keycloak.localhost:18080/realms/basyx-studio
STUDIO_OIDC_CLIENT_ID=studio-web
STUDIO_OIDC_CLIENT_SECRET=studio-web-test-secret
STUDIO_OIDC_SCOPES=openid profile email
STUDIO_OIDC_ROLES_CLAIM=roles
STUDIO_ADMIN_ROLE=studio-admin

# The test targets run on localhost, so private-network targets are allowed.
STUDIO_PRIVATE_NETWORK_TARGETS=allow

# Secret referenced by the "Secured (as Studio)" test target as env:STUDIO_TESTENV_SERVICE_SECRET.
STUDIO_TESTENV_SERVICE_SECRET=studio-service-test-secret

# Runtime-installable apps (MVP-3). App files are served from this separate
# origin by the same Studio Service; *.localhost resolves to loopback.
STUDIO_APPS_URL=http://apps.localhost:3000
# Developer-mode (unsigned) app installs. Off by default for hosted deployments.
STUDIO_APPS_ALLOW_UNSIGNED=true
